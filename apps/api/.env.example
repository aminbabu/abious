# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL in DDEV / Docker)
DATABASE_URL=postgresql://db:db@db:5432/db?sslmode=disable

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters
BETTER_AUTH_URL=http://localhost:3000

# Client Application URL (CORS / Trusted Origins)
CLIENT_URL=http://localhost:5173

# Social Providers - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Social Providers - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP Configuration (Google SMTP / Mailpit)
# For local development with Mailpit (DDEV):
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
#
# For Google SMTP (Production / Staging):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM="Amin Babu" <your-email@gmail.com>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Contact Inquiry Destination Email
CONTACT_RECEIVER_EMAIL=amin.babu.bd@gmail.com
